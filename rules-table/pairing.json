    {
      "id": "pairing.screen-session.ended-not-compared-b",
      "rule": "screen-session",
      "why": "순서를 바꿔도 종료 세션이 이기지 않는지 본다: 결과는 같아야 한다.",
      "source": "PR #25 · TabPairingTests.swift:487(sameTtyPick)",
      "input": {
        "screens": [{"id": "A1", "tty": "ttys001", "session_id": null}],
