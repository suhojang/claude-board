      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "full": {"B": 600}},
      "expect": {"move": "switch A→C [5시간 한도 100%]", "marks": {"A": 1800, "B": 600}}
    },
    {
      "id": "autoswitch.decide.next-drops-stale-marks",
      "rule": "decide",
      "why": "지난 표시는 치우고 그 계정을 다시 후보로 쓴다",
      "source": "AutoSwitchTests.swift:173",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "full": {"B": -1, "C": 0}},
      "expect": {"move": "switch A→B [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.next-replaces-current-mark",
      "rule": "decide",
      "why": "지금 계정의 남은 표시는 새 값으로 바꾼다",
      "source": "AutoSwitchTests.swift:175",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "full": {"A": 99999}},
      "expect": {"move": "switch A→B [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.no-candidate-all-blocked",
      "rule": "decide",
      "why": "저장 계정이 모두 만료이거나 표시가 남으면 바꿀 계정이 없다고 보고, 표시는 새로 바꾼다",
      "source": "AutoSwitchTests.swift:177",
      "input": {"sessions": [{"id": "s1", "limit_at": -5}], "expired": ["B"], "full": {"C": 600, "Q": -5}},
      "expect": {"move": "none [s1 세션이 한도에 걸림(한도 메시지)]", "marks": {"A": 3600, "C": 600}}
    },
    {
      "id": "autoswitch.decide.no-candidate-only-current",
      "rule": "decide",
      "why": "저장 계정이 지금 계정뿐이면 바꿀 계정이 없다",
      "source": "AutoSwitchTests.swift:180",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "saved": ["A"]},
      "expect": {"move": "none [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.no-candidate-empty-saved",
      "rule": "decide",
      "why": "저장 계정이 없으면 바꿀 계정이 없다",
      "source": "AutoSwitchTests.swift:182",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "saved": []},
      "expect": {"move": "none [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.current-expired-still-leaves",
      "rule": "decide",
      "why": "지금 계정이 만료여도 떠난다. 만료는 후보에서만 본다",
      "source": "AutoSwitchTests.swift:184",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "expired": ["A"]},
      "expect": {"move": "switch A→B [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.resume-pre-settle-hits",
      "rule": "decide",
      "why": "이전 계정에서 한도로 멈춘 세션은(전환 뒤 40초가 지나면) 이어 가기 목록으로 내놓는다",
      "source": "AutoSwitchTests.swift:188",
      "input": {"sessions": [{"id": "s1", "limit_at": -980}]},
      "expect": {"move": "stay", "resume": ["s1"]}
    },
    {
      "id": "autoswitch.decide.resume-settle-boundary-counts-pre",
      "rule": "decide",
      "why": "전환 뒤 40초에 딱 걸려 멈춘 세션도 이전 계정에서 멈춘 것으로 쳐서 이어 가기에 넣는다",
      "source": "AutoSwitchTests.swift:190",
      "input": {"sessions": [{"id": "s1", "limit_at": -960}]},
      "expect": {"move": "stay", "resume": ["s1"]}
    },
    {
      "id": "autoswitch.decide.resume-skips-resumed-keeps-order",
      "rule": "decide",
      "why": "이미 이어 가기 요청을 넣은 세션은 빼고, 남은 것은 세션 목록의 차례 그대로 내놓는다",
      "source": "AutoSwitchTests.swift:192",
      "input": {"sessions": [{"id": "s3", "limit_at": -990}, {"id": "s1", "limit_at": -980}, {"id": "s2", "limit_at": -985}], "resumed": ["s1"]},
      "expect": {"move": "stay", "resume": ["s3", "s2"]}
    },
    {
      "id": "autoswitch.decide.resume-filters-states",
      "rule": "decide",
      "why": "끝남·일시중지·승인 대기 세션은 이어 가기 목록에서 빼고, 작업 중·일반 세션은 넣는다",
      "source": "AutoSwitchTests.swift:195",
      "input": {"sessions": [{"id": "s1", "state": "ended", "limit_at": -980}, {"id": "s2", "state": "paused", "limit_at": -980}, {"id": "s3", "state": "waiting", "limit_at": -980}, {"id": "s4", "state": "working", "limit_at": -980}, {"id": "s5", "limit_at": -980}]},
      "expect": {"move": "stay", "resume": ["s4", "s5"]}
    },
    {
      "id": "autoswitch.decide.resume-skips-over-6h",
      "rule": "decide",
      "why": "6시간 넘게 걸려 있던 세션은 이어 가기 목록에서 뺀다",
      "source": "AutoSwitchTests.swift:199",
      "input": {"sessions": [{"id": "s1", "limit_at": -25200}, {"id": "s2", "limit_at": -21595}], "last_switch": -100},
      "expect": {"move": "stay", "resume": ["s2"]}
    },
    {
      "id": "autoswitch.decide.resume-within-settle-none",
      "rule": "decide",
      "why": "settle 안이면 이어 가기 요청을 아직 넣지 않는다",
      "source": "AutoSwitchTests.swift:201",
      "input": {"sessions": [{"id": "s1", "limit_at": -100}], "last_switch": -30},
      "expect": {"move": "stay", "resume": []}
    },
    {
      "id": "autoswitch.decide.resume-ignores-pending-switching-current",
      "rule": "decide",
      "why": "이어 가기는 전환 대기·전환 중·지금 계정을 모르는 것과 관계없이 내놓는다",
      "source": "AutoSwitchTests.swift:202",
      "input": {"sessions": [{"id": "s1", "limit_at": -980}], "current": null, "pending": true, "switching": true},
      "expect": {"move": "stay", "resume": ["s1"]}
    },
    {
      "id": "autoswitch.decide.resume-with-switch-excludes-new-hit",
      "rule": "decide",
      "why": "이어 가기는 전환 결정과 같은 판단에 나오되, 새로 걸린 세션은 이어 가기 목록에 넣지 않는다",
      "source": "AutoSwitchTests.swift:204",
      "input": {"sessions": [{"id": "old", "limit_at": -980}, {"id": "s1", "limit_at": -5}]},
      "expect": {"move": "switch A→B [s1 세션이 한도에 걸림(한도 메시지)] stopped", "marks": {"A": 3600}, "resume": ["old"]}
    },
    {
      "id": "autoswitch.decide.resume-never-switched-all-new",
      "rule": "decide",
      "why": "한 번도 전환한 적이 없으면(마지막 전환이 1970년) settle 이 아주 오래 지나 모든 한도 세션이 새로 걸린 것으로 본다",
      "source": "AutoSwitchTests.swift:207",
      "input": {"sessions": [{"id": "s1", "limit_at": -500}], "last_switch": -3000000},
      "expect": {"move": "switch A→B [s1 세션이 한도에 걸림(한도 메시지)] stopped", "marks": {"A": 3600}}
    },
    {
      "id": "autoswitch.decide.pause-blocks-full",
      "rule": "decide",
      "why": "지금 계정이 쉬는 중이고 쉬기 시작한 계정이 그대로면 한도가 차도 전환하지 않고, 표시도 그대로 둔다",
      "source": "AutoSwitchTests.swift:211",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "pause": {"account": "A", "until": 600}},
      "expect": {"move": "stay"}
    },
    {
      "id": "autoswitch.decide.pause-blocks-new-hit",
      "rule": "decide",
      "why": "지금 계정이 쉬는 중이면 세션이 새로 걸려도 전환하지 않는다",
      "source": "AutoSwitchTests.swift:213",
      "input": {"sessions": [{"id": "s1", "limit_at": -5}], "pause": {"account": "A", "until": 600}},
      "expect": {"move": "stay"}
    },
    {
      "id": "autoswitch.decide.pause-no-candidate-silent",
      "rule": "decide",
      "why": "지금 계정이 쉬는 중이면 바꿀 계정이 없어도 알리지 않는다",
      "source": "AutoSwitchTests.swift:214",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "saved": ["A"], "pause": {"account": "A", "until": 600}},
      "expect": {"move": "stay"}
    },
    {
      "id": "autoswitch.decide.pause-other-account-redecides",
      "rule": "decide",
      "why": "쉬기 시작한 계정이 바뀌었으면 쉬지 않고 다시 판단한다",
      "source": "AutoSwitchTests.swift:216",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "current": "B", "pause": {"account": "A", "until": 600}},
      "expect": {"move": "switch B→C [5시간 한도 100%]", "marks": {"B": 1800}}
    },
    {
      "id": "autoswitch.decide.pause-until-now-redecides",
      "rule": "decide",
      "why": "쉬는 기간의 끝이 꼭 지금이면 끝난 것으로 보고 다시 판단한다",
      "source": "AutoSwitchTests.swift:218",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "pause": {"account": "A", "until": 0}},
      "expect": {"move": "switch A→B [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.pause-past-until-redecides",
      "rule": "decide",
      "why": "쉬는 기간이 지났으면 다시 판단한다",
      "source": "AutoSwitchTests.swift:220",
      "input": {"limits": [{"id": "5h", "pct": 100, "resets": 1800}], "pause": {"account": "A", "until": -1}},
      "expect": {"move": "switch A→B [5시간 한도 100%]", "marks": {"A": 1800}}
    },
    {
      "id": "autoswitch.decide.pause-keeps-resume",
      "rule": "decide",
      "why": "지금 계정이 쉬는 중에도 이어 가기는 그대로 내놓는다",
      "source": "AutoSwitchTests.swift:222",
      "input": {"sessions": [{"id": "old", "limit_at": -980}, {"id": "s1", "limit_at": -5}], "pause": {"account": "A", "until": 600}},
      "expect": {"move": "stay", "resume": ["old"]}
    },
    {
      "id": "autoswitch.failed.target-marks-hour",
      "rule": "failed",
      "why": "대상 계정 쪽 실패는 그 계정만 1시간 고르지 않게 표시하고 쉬지 않는다. 다른 표시는 그대로다",
      "source": "AutoSwitchTests.swift:267",
      "input": {"side": "target", "target": "B", "current": "A", "full": {"A": 1800, "C": 600}},
      "expect": {"marks": {"A": 1800, "B": 3600, "C": 600}}
    },
    {
      "id": "autoswitch.failed.other-pauses-hour",
      "rule": "failed",
      "why": "그 밖(지금 계정·시스템 쪽) 실패는 표시를 그대로 두고, 지금 계정이 그대로인 동안 1시간 쉰다",
      "source": "AutoSwitchTests.swift:273",
      "input": {"side": "other", "target": "B", "current": "A", "full": {"A": 1800}},
      "expect": {"marks": {"A": 1800}, "pause": {"account": "A", "until": 3600}}
    },
    {
      "id": "autoswitch.failed.busy-pauses-30s",
      "rule": "failed",
      "why": "쓰기 잠금을 잡지 못한 실패는 표시를 그대로 두고 30초만 쉰 뒤 같은 후보부터 다시 판단한다",
      "source": "AutoSwitchTests.swift:279",
      "input": {"side": "busy", "target": "B", "current": "A", "full": {"A": 7200}},
      "expect": {"marks": {"A": 7200}, "pause": {"account": "A", "until": 30}}
    }
  ]
}