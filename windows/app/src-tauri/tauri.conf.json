{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Board",
  "mainBinaryName": "ClaudeBoard",
  "version": "2.12.0",
  "identifier": "com.claude.board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Claude Board",
        "url": "index.html",
        "width": 454,
        "height": 720,
        "minWidth": 300,
        "minHeight": 144,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../plugins/md-render/LICENSE": "plugins/md-render/LICENSE",
      "../../../plugins/md-render/README.md": "plugins/md-render/README.md",
      "../../../plugins/md-render/.claude-plugin/plugin.json": "plugins/md-render/.claude-plugin/plugin.json",
      "../../../plugins/md-render/hooks/hooks.json": "plugins/md-render/hooks/hooks.json",
      "../../../plugins/md-render/hooks/register.tsx": "plugins/md-render/hooks/register.tsx",
      "../../packaging/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
